# ---- AgriFlow environment (copy to .env, NEVER commit real values) ----

# Core
ENVIRONMENT=development                 # development | production | test
AUTH_SECRET=change-me-to-a-long-random-string   # REQUIRED in production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (SQLite default for dev/demo; PostgreSQL in production via docker-compose)
DATABASE_URL=sqlite:///./agriflow.db
# DATABASE_URL=postgresql+psycopg://agriflow:agriflow@postgres:5432/agriflow

# Redis (optional: shared cache/rate-limits across processes when set)
REDIS_URL=

# Weather provider: open_meteo (free, keyless) | none | static (tests)
WEATHER_PROVIDER=open_meteo
WEATHER_BASE_URL=https://api.open-meteo.com
WEATHER_CACHE_MINUTES=30
OPEN_METEO_API_KEY=            # not required for the free personal-use API

# Email notifications (optional; leaving unset = in-app notifications only,
# the system NEVER pretends to send email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

*** Map tiles use OpenStreetMap raster (no key required). Optional override:
MAP_PROVIDER_KEY=

# Demo seed (creates demo farm + synthetic labeled data on first boot)
DEMO_SEED_ENABLED=true

# CORS (comma-separated origins of the web app)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limits
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_READ_PER_MIN=120
RATE_LIMIT_WRITE_PER_MIN=30

# ---- frontend (apps/web/.env.local) ----
NEXT_PUBLIC_API_BASE=http://localhost:8000
